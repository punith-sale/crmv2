# ── Origin CRM — environment configuration ────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# The Google Sheet that acts as the database.
# This is the ID from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=1zxqIcFIUX9t3pey6FYtuENkRLhwxRuv5shIJHnLPelU

# Port the local API server listens on.
PORT=8787

# ── Google OAuth ───────────────────────────────────────────────────────────
# Path to the OAuth *Desktop app* client credentials downloaded from the
# Google Cloud Console. Defaults to ./credentials.json in the repo root.
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Where the cached OAuth token is stored after you log in once.
GOOGLE_TOKEN_PATH=./token.json

# ── Tab name overrides (optional) ────────────────────────────────────────────
# The server auto-detects tabs by fuzzy-matching their titles. Override here
# only if auto-detection picks the wrong tab.
# SHEET_TAB_DEALS=Deals
# SHEET_TAB_LEADS=Leads

# ── Claude enrichment ────────────────────────────────────────────────────────
# Command used to invoke the local Claude Code CLI. Usually just "claude".
CLAUDE_CLI=claude
# Max time (ms) to wait for an enrichment run before giving up.
ENRICH_TIMEOUT_MS=180000

# ── Plugins ──────────────────────────────────────────────────────────────────
# Comma-separated list of plugin directory names to load from server/plugins.
# Leave empty to load all that are present.
# ENABLED_PLUGINS=webhook-notifier
# Optional outbound webhook for the example "webhook-notifier" plugin.
# WEBHOOK_NOTIFIER_URL=
